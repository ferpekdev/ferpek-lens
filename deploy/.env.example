# FERPEK Lens release to run.
#
# "latest" tracks the latest published stable image.
# A specific version can also be used, for example:
# FERPEK_VERSION=0.3.0
FERPEK_VERSION=latest

# Web interface port.
FERPEK_WEB_PORT=5173

# FERPEK Server API and Agent communication port.
FERPEK_PORT=8000

# Official FERPEK Pack Registry.
PACK_REGISTRY_URL=https://raw.githubusercontent.com/ferpekdev/ferpek-lens-packs/main/index.json
