[Unit]
Description=FERPEK Lens Update Helper
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/ferpek-lens-server/update-helper.py
Environment=FERPEK_INSTALL_DIR=/opt/ferpek-lens-server
Environment=FERPEK_UPDATER_SOCKET=/run/ferpek-lens/updater.sock
Restart=on-failure
RestartSec=3

RuntimeDirectory=ferpek-lens
RuntimeDirectoryMode=0755

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
